# Copy to .env next to docker-compose.yml. Tokens are stored as SHA-256 hashes;
# make them with: docker compose run --rm ptouch ptouch-command-server token [-client NAME]

MCP_DOMAIN=example.com

# The board (required).
PTOUCH_BOARD_TOKEN_SHA256=

# REST/MCP clients: name:sha256,name:sha256
PTOUCH_CLIENT_TOKENS=

# Dex sign-in for claude.ai. Register a Dex client "ptouch-mcp" set up like bookstack-mcp's.
MCP_OIDC_ISSUER=https://auth.example.com
MCP_RESOURCE_URL=https://ptouch.example.com/mcp
MCP_ALLOWED_EMAILS=

# The web UI at https://ptouch.<MCP_DOMAIN>/, signed in through Dex (needs the
# Dex settings above). Register a confidential Dex client "ptouch-web" with the
# redirect URI https://ptouch.<MCP_DOMAIN>/auth/callback, and put its secret here.
WEB_UI=false
PTOUCH_WEB_OIDC_SECRET=
